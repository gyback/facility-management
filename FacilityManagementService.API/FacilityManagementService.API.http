@FacilityManagementService.API_HostAddress = http://localhost:5102

# The OpenAPI document, which lists every endpoint.
GET {{FacilityManagementService.API_HostAddress}}/openapi/v1.json
Accept: application/json

###

# Every endpoint except /openapi/v1.json and the health probes needs a bearer
# token (ADR-0015), and every POST needs an Idempotency-Key header (ADR-0017), e.g.:
# POST {{FacilityManagementService.API_HostAddress}}/facilities
# Authorization: Bearer {{token}}
# Content-Type: application/json
# Idempotency-Key: {{$random.uuid}}
